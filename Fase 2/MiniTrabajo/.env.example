# URL de la base de datos en Supabase (ej: https://ajbgaivxwszqdadagbxgfdsholaqueaceoottewb.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de la API (anon / publishable key)
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui